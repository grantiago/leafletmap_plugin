<?xml version="1.0" encoding="utf-8"?>
<updates>
  <update>
    <name>Leaflet Map Plugin</name>
    <description>
      1.2.0: Added wrap-left and wrap-right map alignment with text wrapping. Fixed left/center/right alignment, which had no effect in articles. Fixed Spanish language files that failed to load. Security hardening of shortcode parameters; removed unused includes/geojson.php.
    </description>
    <element>leafletmap</element>
    <type>plugin</type>
    <folder>system</folder>

    <version>1.2.0</version>

    <infourl title="Leaflet Map Plugin">
      https://github.com/grantiago/leafletmap_plugin#readme
    </infourl>

    <downloads>
      <downloadurl type="full" format="zip">
        https://github.com/grantiago/leafletmap_plugin/releases/download/1.2.0/plg_leaflet_map_1.2.0.zip
      </downloadurl>

      <downloadsource type="full" format="zip">
        https://github.com/grantiago/leafletmap_plugin/releases/download/1.2.0/plg_leaflet_map_1.2.0.zip
      </downloadsource>

      <sha256>de245524a0f4d1993e4ae446fce3d45c0e61ae9599bcaa7f93ba3d1506f26ca4</sha256>
    </downloads>

    <tags>
      <tag>stable</tag>
    </tags>

    <maintainer>Grant Amaral</maintainer>
    <maintainerurl>https://github.com/grantiago/leafletmap_plugin</maintainerurl>

    <!-- Joomla 4 and 5 -->
    <targetplatform name="joomla" version="^4 || ^5" />

    <!-- Plugins use client="site" or "administrator", but install to both -->
    <client>site</client>
  </update>
</updates>
