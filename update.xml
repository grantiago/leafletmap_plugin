<?xml version="1.0" encoding="utf-8"?>
<updates>
  <update>
    <name>Leaflet Map Plugin</name>
    <description>
      1.1.0: Added kml_label and geojson_label shortcode parameters to set the layer names in the map layer control. Defaults are "KML Layer" and "GeoJson Layer".
    </description>
    <element>leafletmap</element>
    <type>plugin</type>
    <folder>system</folder>

    <version>1.1.0</version>

    <infourl title="Leaflet Map Plugin">
      https://github.com/grantiago/leafletmap_plugin#readme
    </infourl>

    <downloads>
      <downloadurl type="full" format="zip">
        https://github.com/grantiago/leafletmap_plugin/releases/download/1.1.0/plg_leaflet_map_1.1.0.zip
      </downloadurl>

      <downloadsource type="full" format="zip">
        https://github.com/grantiago/leafletmap_plugin/releases/download/1.1.0/plg_leaflet_map_1.1.0.zip
      </downloadsource>

      <sha256>0e4ed5a648c899a5c2505ff083c8cb533aac85f7935d033846b3495a6b5721ef</sha256>
    </downloads>

    <tags>
      <tag>stable</tag>
    </tags>

    <maintainer>Grant Amaral</maintainer>
    <maintainerurl>https://github.com/grantiago/leafletmap_plugin</maintainerurl>

    <!-- Joomla 4 and 5 -->
    <targetplatform name="joomla" version="^4 || ^5" />

    <!-- Plugins use client="site" or "administrator", but install to both -->
    <client>site</client>
  </update>
</updates>
